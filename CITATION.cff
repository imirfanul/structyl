    website: 'https://www.imirfanul.com'
repository-code: 'https://github.com/imirfanul/structyl'
url: 'https://www.structyl.com'
license: MIT
keywords:
  - react
  - component-library
  - ui
  - tailwindcss
  - accessibility
  - wai-aria
  - headless-ui
  - design-system
  - typescript
