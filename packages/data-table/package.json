{
  "name": "@structyl/data-table",
  "version": "1.0.2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imirfanul/structyl.git",
    "directory": "packages/data-table"
  },
  "homepage": "https://www.structyl.com",
  "bugs": "https://github.com/imirfanul/structyl/issues",
  "author": {
    "name": "Mohammed Irfanul Alam Tanveer",
    "url": "https://www.imirfanul.com"
  },
  "publishConfig": {
    "access": "public"
  },
  "description": "Headless-powered React DataTable built on TanStack Table with sorting, filtering, virtualization, grouping, inline editing, and server-side data.",
  "keywords": [
    "react",
    "typescript",
    "structyl",
    "data-table",
    "datagrid",
    "table",
    "tanstack-table",
    "virtualization",
    "sorting",
    "filtering",
    "server-side",
    "inline-editing",
    "csv-export"
  ],
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@structyl/hooks": "workspace:*",
    "@structyl/icons": "workspace:*",
    "@structyl/primitives": "workspace:*",
    "@structyl/styled": "workspace:*",
    "@structyl/utils": "workspace:*",
    "@tanstack/react-table": "^8.20.5",
    "@tanstack/react-virtual": "^3.10.8",
    "xlsx": "^0.18.5"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.0.1",
    "@types/react": "^19.0.0",
    "jsdom": "^25.0.1",
    "react": "^19.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.2"
  }
}
