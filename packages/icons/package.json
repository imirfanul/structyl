{
  "name": "@structyl/icons",
  "version": "1.0.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imirfanul/structyl.git",
    "directory": "packages/icons"
  },
  "homepage": "https://www.structyl.com",
  "bugs": "https://github.com/imirfanul/structyl/issues",
  "author": {
    "name": "Mohammed Irfanul Alam Tanveer",
    "url": "https://www.imirfanul.com"
  },
  "publishConfig": {
    "access": "public"
  },
  "description": "The structyl icon set: 1000+ tree-shakeable SVG icon components re-exported from lucide-react, typed for React 18 and 19.",
  "keywords": [
    "react",
    "typescript",
    "structyl",
    "icons",
    "svg",
    "lucide",
    "lucide-react",
    "icon-components",
    "tree-shakeable",
    "ui"
  ],
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "lucide-react": "^0.453.0"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.3"
  }
}
