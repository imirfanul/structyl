{
  "name": "@structyl/hooks",
  "version": "1.0.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imirfanul/structyl.git",
    "directory": "packages/hooks"
  },
  "homepage": "https://www.structyl.com",
  "bugs": "https://github.com/imirfanul/structyl/issues",
  "author": {
    "name": "Mohammed Irfanul Alam Tanveer",
    "url": "https://www.imirfanul.com"
  },
  "publishConfig": {
    "access": "public"
  },
  "description": "SSR-safe, tree-shakeable React hooks for state, refs, DOM, browser APIs, and performance, including useControllableState for headless UI",
  "keywords": [
    "react",
    "typescript",
    "structyl",
    "hooks",
    "react-hooks",
    "ssr",
    "use-controllable-state",
    "use-debounce",
    "use-media-query",
    "use-local-storage",
    "tree-shakeable"
  ],
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.2"
  }
}
