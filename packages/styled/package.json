{
  "name": "@structyl/styled",
  "version": "1.0.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imirfanul/structyl.git",
    "directory": "packages/styled"
  },
  "homepage": "https://www.structyl.com",
  "bugs": "https://github.com/imirfanul/structyl/issues",
  "author": {
    "name": "Mohammed Irfanul Alam Tanveer",
    "url": "https://www.imirfanul.com"
  },
  "publishConfig": {
    "access": "public"
  },
  "description": "Tailwind CSS v4 styled React components built on accessible WAI-ARIA primitives, with a token-driven theme preset and type-safe variants.",
  "keywords": [
    "react",
    "typescript",
    "structyl",
    "ui-components",
    "tailwindcss",
    "tailwind-variants",
    "design-system",
    "accessible",
    "wai-aria",
    "headless",
    "compound-components",
    "theming",
    "rsc"
  ],
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./tailwind-preset": {
      "types": "./dist/tailwind-preset.d.ts",
      "import": "./dist/tailwind-preset.mjs",
      "require": "./dist/tailwind-preset.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@structyl/core": "workspace:*",
    "@structyl/primitives": "workspace:*",
    "@structyl/themes": "workspace:*",
    "@structyl/utils": "workspace:*",
    "@structyl/icons": "workspace:*",
    "tailwind-variants": "^0.3.0"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "tailwindcss": "^3.4.0 || ^4.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "jest-axe": "^9.0.0",
    "jsdom": "^25.0.1",
    "react": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "tailwindcss-animate": "^1.0.7",
    "tsup": "^8.3.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.2"
  }
}
