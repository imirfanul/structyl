{
  "name": "@structyl/cli",
  "version": "1.0.0",
  "publishConfig": { "access": "public" },
  "description": "CLI for adding @structyl components to your project (shadcn-style)",
  "license": "MIT",
  "type": "module",
  "bin": {
    "structyl": "./dist/index.js"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "prompts": "^2.4.2",
    "kleur": "^4.1.5",
    "ora": "^8.1.0",
    "execa": "^9.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "@types/prompts": "^2.4.9",
    "tsup": "^8.3.0",
    "typescript": "^5.6.3"
  }
}
