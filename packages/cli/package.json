{
  "name": "@structyl/cli",
  "version": "1.0.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imirfanul/structyl.git",
    "directory": "packages/cli"
  },
  "homepage": "https://www.structyl.com",
  "bugs": "https://github.com/imirfanul/structyl/issues",
  "author": {
    "name": "Mohammed Irfanul Alam Tanveer",
    "url": "https://www.imirfanul.com"
  },
  "publishConfig": {
    "access": "public"
  },
  "description": "Command-line tool for scaffolding structyl projects and copying styled components into your codebase with automatic dependency resolution.",
  "keywords": [
    "react",
    "typescript",
    "structyl",
    "cli",
    "shadcn",
    "scaffold",
    "components",
    "registry",
    "tailwind",
    "commander",
    "code-generation"
  ],
  "license": "MIT",
  "type": "module",
  "bin": {
    "structyl": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "prompts": "^2.4.2",
    "kleur": "^4.1.5",
    "ora": "^8.1.0",
    "execa": "^9.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "@types/prompts": "^2.4.9",
    "tsup": "^8.3.0",
    "typescript": "^5.6.3"
  }
}
